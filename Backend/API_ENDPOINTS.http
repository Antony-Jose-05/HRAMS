@baseUrl = http://localhost:5225
@apiBaseUrl = {{baseUrl}}/api
@adminUsername = admin
@adminPassword = admin123
@authToken = REPLACE_WITH_VALID_JWT

### ============================================
### STAYDESK API
### ============================================

### Health Check
GET {{baseUrl}}/health
Accept: application/json

### Register Admin (Create initial admin account)
POST {{apiBaseUrl}}/admin/register
Content-Type: application/json

{
  "username": "{{adminUsername}}",
  "password": "{{adminPassword}}"
}

### Login Admin (Get JWT Token)
POST {{apiBaseUrl}}/admin/login
Content-Type: application/json

{
  "username": "{{adminUsername}}",
  "password": "{{adminPassword}}"
}

### ============================================
### ROOM ENDPOINTS
### ============================================

### Get All Rooms (Requires JWT auth)
GET {{apiBaseUrl}}/rooms
Accept: application/json
Authorization: Bearer {{authToken}}

### Get Room by ID (Requires JWT auth)
GET {{apiBaseUrl}}/rooms/1
Accept: application/json
Authorization: Bearer {{authToken}}

### Get Available Rooms for Date Range (Requires JWT auth)
GET {{apiBaseUrl}}/rooms/availability?checkIn=2026-06-01T14:00:00&checkOut=2026-06-05T11:00:00
Accept: application/json
Authorization: Bearer {{authToken}}

### Create New Room (Admin only)
POST {{apiBaseUrl}}/rooms
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "roomNumber": "301",
  "type": "Deluxe",
  "price": 1200.00,
  "floor": 3
}

### Update Room (Admin only)
PUT {{apiBaseUrl}}/rooms/1
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "type": "Suite",
  "price": 1500.00,
  "floor": 2
}

### Delete Room (Admin only)
DELETE {{apiBaseUrl}}/rooms/1
Authorization: Bearer {{authToken}}

### ============================================
### BOOKING ENDPOINTS
### ============================================

### Get All Bookings (Admin only)
GET {{apiBaseUrl}}/bookings
Accept: application/json
Authorization: Bearer {{authToken}}

### Get Booking by ID (Admin only)
GET {{apiBaseUrl}}/bookings/1
Accept: application/json
Authorization: Bearer {{authToken}}

### Get Bookings for Specific Room (Admin only)
GET {{apiBaseUrl}}/bookings/room/1
Accept: application/json
Authorization: Bearer {{authToken}}

### Create New Booking (Requires JWT auth)
POST {{apiBaseUrl}}/bookings
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "roomId": 1,
  "guestName": "John Doe",
  "phone": "9876543210",
  "checkInDate": "2026-06-01T14:00:00",
  "checkOutDate": "2026-06-05T11:00:00"
}

### Update Booking (Admin only)
PUT {{apiBaseUrl}}/bookings/1
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "guestName": "Jane Doe",
  "phone": "9876543210",
  "status": "CheckedIn"
}

### Cancel Booking (Admin only)
DELETE {{apiBaseUrl}}/bookings/1
Authorization: Bearer {{authToken}}

### ============================================
### TESTING FLOW
### ============================================

### 1. First, login to get a token
### 2. Replace REPLACE_WITH_VALID_JWT with the JWT from login
### 3. Then test protected endpoints with Authorization: Bearer {{authToken}}
